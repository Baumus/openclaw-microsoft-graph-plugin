{
  "name": "@baumus/openclaw-microsoft-graph",
  "version": "3.5.3",
  "description": "Bring Outlook mail and calendar, OneDrive files, and Microsoft To Do into OpenClaw with per-agent access you control.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "assets/ICON_PROVENANCE.md",
    "assets/icon.png",
    "dist/index.js",
    "docs/ARCHITECTURE.md",
    "docs/CREDENTIAL_VAULT_DESIGN.md",
    "docs/OAUTH_ACCESS_MATRIX.md",
    "docs/SUPPORT.md",
    "examples/microsoft-graph-policy.json5",
    "examples/microsoft-graph-policy-v2.json5",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "openclaw.plugin.json",
    "scripts/bounded-json.mjs",
    "dist/control-ui/",
    "src/control-ui.ts",
    "src/control-ui-i18n.ts",
    "src/control-ui.css"
  ],
  "scripts": {
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/index.js",
    "plugin:build": "npm run build && openclaw plugins build --root . --entry ./dist/index.js",
    "plugin:build:check": "openclaw plugins build --check --root . --entry ./dist/index.js",
    "plugin:validate": "openclaw plugins validate --json --root . --entry ./dist/index.js",
    "package:check": "node scripts/check-package-contents.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "microsoft-365",
    "outlook",
    "outlook-mail",
    "outlook-calendar",
    "onedrive",
    "microsoft-to-do",
    "email",
    "calendar",
    "files",
    "tasks",
    "openclaw",
    "microsoft-graph"
  ],
  "author": "Baumus",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Baumus/openclaw-microsoft-graph-plugin#readme",
  "bugs": {
    "url": "https://github.com/Baumus/openclaw-microsoft-graph-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baumus/openclaw-microsoft-graph-plugin.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.6"
  },
  "dependencies": {
    "@openclaw/fs-safe": "0.21.1",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "clawhub": "0.23.3",
    "esbuild": "^0.28.2",
    "openclaw": "2026.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.6",
      "minGatewayVersion": ">=2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.9.6",
      "pluginSdkVersion": "2026.9.6"
    },
    "install": {
      "clawhubSpec": "clawhub:@baumus/openclaw-microsoft-graph",
      "npmSpec": "@baumus/openclaw-microsoft-graph@3.5.3",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.9.6"
    },
    "controlUi": "./src/control-ui.ts"
  },
  "overrides": {
    "clawhub": {
      "undici": "7.29.1"
    }
  }
}
