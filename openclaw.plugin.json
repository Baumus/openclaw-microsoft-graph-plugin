{
  "id": "microsoft-graph",
  "name": "Microsoft 365 for OpenClaw",
  "description": "Bring Outlook mail and calendar, OneDrive files, and Microsoft To Do into OpenClaw with per-agent access you control.",
  "version": "3.11.0",
  "categories": [
    "productivity"
  ],
  "cliCommands": [
    {
      "name": "microsoft-graph",
      "description": "Microsoft Graph operator commands",
      "hasSubcommands": true
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false
      },
      "warningApprovalsRequired": {
        "type": "boolean",
        "default": true,
        "description": "Require OpenClaw-native approval for warning-level Microsoft Graph mutations. Missing defaults to true; set false only when policy-authorized warning mutations may proceed without an approval prompt."
      },
      "credentialVaultKey": {
        "type": "object",
        "required": [
          "source",
          "provider",
          "id"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "env",
              "file",
              "exec",
              "store"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "nativeBoundaryEnabled": {
        "type": "boolean",
        "default": false,
        "description": "Expose the closed authenticated Native OS connected-action socket."
      },
      "nativeBoundaryKey": {
        "type": "object",
        "required": [
          "source",
          "provider",
          "id"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "env",
              "file",
              "exec",
              "store"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "nativeBoundaryAgentId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._-]+$",
        "default": "main"
      },
      "nativeBoundarySocketPath": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "nativeExecutionRequired": {
        "type": "boolean",
        "default": false,
        "description": "Require one exact, short-lived Native OS execution permit immediately before every Microsoft Graph effect."
      },
      "nativeExecutionPublicKey": {
        "type": "object",
        "required": [
          "source",
          "provider",
          "id"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "env",
              "file",
              "exec",
              "store"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "nativeExecutionSocketPath": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "nativeExecutionSocketOwnerUid": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295,
        "default": 0
      },
      "policy": {
        "type": "object",
        "required": [
          "version",
          "rules",
          "services"
        ],
        "properties": {
          "version": {
            "type": "number",
            "const": 2
          },
          "rules": {
            "type": "object",
            "required": [
              "default"
            ],
            "properties": {
              "default": {
                "type": "string",
                "const": "deny"
              },
              "warningApprovalsByService": {
                "type": "object",
                "properties": {
                  "onedrive": {
                    "type": "boolean"
                  },
                  "calendar": {
                    "type": "boolean"
                  },
                  "mail": {
                    "type": "boolean"
                  },
                  "todo": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "services": {
            "type": "object",
            "required": [
              "onedrive",
              "calendar",
              "mail",
              "todo"
            ],
            "properties": {
              "onedrive": {
                "type": "object",
                "required": [
                  "allowed_roots"
                ],
                "properties": {
                  "allowed_roots": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "label",
                        "path",
                        "drive_id",
                        "item_id",
                        "include_descendants",
                        "permissions",
                        "agents"
                      ],
                      "properties": {
                        "label": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]{0,159}$"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "drive_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "item_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "include_descendants": {
                          "type": "boolean",
                          "const": true
                        },
                        "agents_instructions": {
                          "type": "string",
                          "const": "trusted"
                        },
                        "permissions": {
                          "type": "object",
                          "required": [
                            "read",
                            "write",
                            "delete"
                          ],
                          "properties": {
                            "read": {
                              "type": "boolean"
                            },
                            "write": {
                              "type": "boolean"
                            },
                            "delete": {
                              "type": "boolean"
                            }
                          },
                          "additionalProperties": false
                        },
                        "agents": {
                          "type": "object",
                          "patternProperties": {
                            "^.*$": {
                              "type": "object",
                              "required": [
                                "permissions"
                              ],
                              "properties": {
                                "permissions": {
                                  "type": "object",
                                  "properties": {
                                    "read": {
                                      "type": "boolean"
                                    },
                                    "write": {
                                      "type": "boolean"
                                    },
                                    "delete": {
                                      "type": "boolean"
                                    }
                                  },
                                  "additionalProperties": false
                                }
                              },
                              "additionalProperties": false
                            }
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              "calendar": {
                "type": "object",
                "required": [
                  "agents"
                ],
                "properties": {
                  "agents": {
                    "type": "object",
                    "patternProperties": {
                      "^.*$": {
                        "type": "object",
                        "required": [
                          "operations"
                        ],
                        "properties": {
                          "operations": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "read",
                                "create",
                                "update",
                                "respond",
                                "attach",
                                "delete"
                              ]
                            },
                            "minItems": 1
                          },
                          "resources": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "minItems": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  }
                },
                "additionalProperties": false
              },
              "mail": {
                "type": "object",
                "required": [
                  "agents"
                ],
                "properties": {
                  "agents": {
                    "type": "object",
                    "patternProperties": {
                      "^.*$": {
                        "type": "object",
                        "required": [
                          "operations"
                        ],
                        "properties": {
                          "operations": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "read",
                                "draft",
                                "update",
                                "move",
                                "mark",
                                "send",
                                "delete"
                              ]
                            },
                            "minItems": 1
                          },
                          "resources": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "minItems": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  }
                },
                "additionalProperties": false
              },
              "todo": {
                "type": "object",
                "required": [
                  "agents"
                ],
                "properties": {
                  "agents": {
                    "type": "object",
                    "patternProperties": {
                      "^.*$": {
                        "type": "object",
                        "required": [
                          "operations"
                        ],
                        "properties": {
                          "operations": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "read",
                                "create",
                                "update",
                                "delete"
                              ]
                            },
                            "minItems": 1
                          },
                          "resources": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "minItems": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 30000,
        "default": 5000
      },
      "readOperationTimeoutMs": {
        "type": "integer",
        "minimum": 5000,
        "maximum": 300000,
        "default": 30000,
        "description": "Whole-operation deadline for multi-request reads; each Graph request remains bounded by requestTimeoutMs."
      },
      "calendarMultiwriteTimeoutMs": {
        "type": "integer",
        "minimum": 30000,
        "maximum": 1800000,
        "default": 300000,
        "description": "Whole-operation deadline for calendar multiwrite, including authorization, credential exchange, and every 20-request Graph batch."
      },
      "maxConcurrent": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8,
        "default": 4
      },
      "maxReadBytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 268435456000,
        "default": 268435456000,
        "description": "Maximum OneDrive bytes streamed for digest mode; aligned with the 250 GB OneDrive individual-file limit."
      },
      "maxReadOutputBytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 1048576,
        "default": 262144,
        "description": "Separate bound for model-facing text reads and To Do attachment retrieval; OneDrive private-media downloads stream to the managed media store under the provider file limit."
      },
      "maxAttachmentDownloadBytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 157286400,
        "default": 157286400,
        "description": "Maximum Outlook file-attachment bytes streamed into OpenClaw's private media store."
      },
      "attachmentDownloadTimeoutMs": {
        "type": "integer",
        "minimum": 30000,
        "maximum": 1800000,
        "default": 600000,
        "description": "Whole-operation timeout for Outlook attachment metadata validation and binary download."
      },
      "oneDriveTransferTimeoutMs": {
        "type": "integer",
        "minimum": 30000,
        "maximum": 604800000,
        "default": 86400000,
        "description": "Whole-operation deadline for OneDrive private-media downloads and uploads; each Graph request remains bounded by requestTimeoutMs."
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "credentialVaultKey",
          "expected": "string",
          "ownerKind": "capability"
        },
        {
          "path": "nativeBoundaryKey",
          "expected": "string",
          "ownerKind": "capability"
        },
        {
          "path": "nativeExecutionPublicKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "controlUi": {
    "entry": "dist/control-ui/44319c4a45d301ab20f712de6d431f116c2434aee47cfb64b948ad8fe39b6617/index.js",
    "styles": [
      "dist/control-ui/44319c4a45d301ab20f712de6d431f116c2434aee47cfb64b948ad8fe39b6617/index.css"
    ]
  },
